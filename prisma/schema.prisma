generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SHOPPER
  ADMIN
}

model Product {
  id                Int         @id @default(autoincrement())
  sheetgenId        Int?        @unique
  title             String
  description       String?
  basePrice         Float
  price             Float
  currency          String      @default("XOF")
  brand             String?
  category          String?
  categoryHierarchy String?
  tags              String?
  colors            String?
  materials         String?
  features          String?
  metaDescription   String?
  slug              String      @unique
  seoKeywords       String?
  imageUrl          String?
  isActive          Boolean     @default(true)
  confidence        Float?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orderItems        OrderItem[]
}

model Customer {
  id                    Int      @id @default(autoincrement())
  name                  String?
  phone                 String   @unique
  quartier              String?
  pinHash               String?
  role                  UserRole @default(CUSTOMER)
  createdAt             DateTime @default(now())
  orders                Order[]  @relation("CustomerOrders")
  assignedShopperOrders Order[]  @relation("AssignedShopperOrders")
  orderNotes            OrderNote[]
}

model OtpSession {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([phone])
}

model Order {
  id                    Int         @id @default(autoincrement())
  orderNumber           String      @unique
  customerId            Int?
  customer              Customer?   @relation("CustomerOrders", fields: [customerId], references: [id])
  assignedShopperId     Int?
  assignedShopper       Customer?   @relation("AssignedShopperOrders", fields: [assignedShopperId], references: [id])
  guestName             String?
  guestPhone            String?
  quartier              String
  address               String?
  deliveryFee           Float
  subtotal              Float
  total                 Float
  paymentMethod         String
  paymentStatus         String      @default("PENDING")
  orderStatus           String      @default("NEW")
  omTransactionId       String?
  orangeMoneyPayToken   String?
  orangeMoneyNotifToken String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  items                 OrderItem[]
  notes                 OrderNote[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  available Boolean @default(true)
}

model OrderNote {
  id             Int       @id @default(autoincrement())
  orderId        Int
  order          Order     @relation(fields: [orderId], references: [id])
  authorId       Int?
  author         Customer? @relation(fields: [authorId], references: [id])
  body           String
  createdAt      DateTime  @default(now())

  @@index([orderId])
}

enum VerificationStatus {
  PENDING        // Nouvelle demande, pas encore traitée
  WAITING_DOCS   // WhatsApp envoyé, en attente du justificatif
  DOCS_RECEIVED  // Documents reçus, en cours d'examen
  APPROVED       // Entreprise vérifiée et approuvée
  REJECTED       // Demande rejetée
}

model BusinessVerification {
  id              Int                @id @default(autoincrement())
  businessName    String
  ownerName       String
  phone           String
  quartier        String?
  description     String?
  status          VerificationStatus @default(PENDING)
  whatsappSentAt  DateTime?          // Date d'envoi du message WhatsApp
  docsReceivedAt  DateTime?          // Date de réception des justificatifs
  resolvedAt      DateTime?          // Date d'approbation ou refus
  adminNote       String?            // Note interne de l'admin
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
}
